# Public key ID is safe to expose. Never put the secret in VITE_* variables.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Optional. Create this in Razorpay Dashboard → Settings → Webhooks.
# Endpoint: https://your-domain.com/api/webhook  Event: payment.captured
RAZORPAY_WEBHOOK_SECRET=

# Optional. Shown after a verified payment (Google Drive / Notion / LMS link).
COURSE_ACCESS_URL=

# Gmail inbox for new checkout leads. Create an App Password:
# Google Account → Security → 2-Step Verification → App passwords
LEAD_EMAIL=pratikpathak2004@gmail.com
GMAIL_USER=pratikpathak2004@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Switch these to rzp_live_... keys when going to production. No code change needed.
