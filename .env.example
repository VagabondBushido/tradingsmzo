# Public key ID is safe to expose. Never put the secret in VITE_* variables.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Optional. Create this in Razorpay Dashboard → Settings → Webhooks.
# Endpoint: https://your-domain.com/api/webhook  Event: payment.captured
RAZORPAY_WEBHOOK_SECRET=

# Shown after a verified payment. Admin can also change this at /admin.
COURSE_ACCESS_URL=https://chat.whatsapp.com/HkrD3kiOGiT8nC5Vgsr6kx?s=cl&p=a&mlu=4&ilr=4
COURSE_PRICE_INR=499

# Optional ads / analytics (build-time). Leave empty until you have IDs.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXX
# VITE_GOOGLE_ADS_ID=AW-XXXXXXXX
# VITE_GOOGLE_ADS_CONVERSION=AW-XXXXXXXX/xxxxxxxxx
# Create a GitHub personal access token with "Contents" write for this repo.
GITHUB_TOKEN=

# Gmail inbox for new checkout leads. Create an App Password:
# Google Account → Security → 2-Step Verification → App passwords
LEAD_EMAIL=pratikpathak2004@gmail.com
GMAIL_USER=pratikpathak2004@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
ADMIN_PASSWORD=pratikpathak2004

# Switch these to rzp_live_... keys when going to production. No code change needed.
